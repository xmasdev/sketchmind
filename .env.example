# SketchMind talks to any OpenAI-compatible Chat Completions API.
# Copy this file to .env.local and adjust. Everything is optional.

# Ollama (default) — runs locally, no key needed
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2

# LM Studio:      LLM_BASE_URL=http://localhost:1234/v1
# llama.cpp:      LLM_BASE_URL=http://localhost:8080/v1
# Mistral cloud:  LLM_BASE_URL=https://api.mistral.ai/v1   LLM_MODEL=mistral-small-latest
# Groq:           LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# Hard cap on reply length (small models sometimes loop)
LLM_MAX_TOKENS=1500
